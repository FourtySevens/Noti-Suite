# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SCHEDULER_API_KEY=replace-with-a-random-key-of-at-least-32-characters

# Create this with `docker compose exec ntfy ntfy token add scheduler` after setup.
NTFY_TOKEN=

# Planned LAN IP of the future Docker host; verify it before deploying.
HOST_BIND_ADDRESS=192.168.0.144
