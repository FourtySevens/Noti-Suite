# Optional: use these listeners if you later move cloudflared to the Caddy LXC.
# Publish ntfy.foursevens.win to http://127.0.0.1:8081 and
# scheduler.foursevens.win to http://127.0.0.1:8082.
# Noti-Suite LXC currently uses 192.168.0.40.
http://:8081 {
	bind 127.0.0.1
	reverse_proxy 192.168.0.40:8093
}

http://:8082 {
	bind 127.0.0.1
	reverse_proxy 192.168.0.40:8080
}
