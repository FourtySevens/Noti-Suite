# Add this listener to your existing Caddy LXC configuration.
# Cloudflare Tunnel publishes ntfy.foursevens.win and points to http://127.0.0.1:8081.
# Verify the application LXC's planned IP before enabling it.
http://:8081 {
	bind 127.0.0.1

	handle_path /scheduler/* {
		reverse_proxy 192.168.0.144:8080
	}

	handle {
		reverse_proxy 192.168.0.144:8093
	}
}
